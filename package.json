{
  "name": "gan-si-sur-sadhana",
  "version": "2.0.0",
  "description": "Sur Sadhana Pro - Indian Classical Vocal Riyaz and Pitch Trainer (Node.js & Express + SQLite)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest",
    "test:browser": "playwright test",
    "validate:ragas": "node scripts/validate-ragas.cjs",
    "android:sync": "cap sync android",
    "android:build": "cap sync android && cd android && gradlew assembleDebug",
    "android:open": "cap open android"
  },
  "keywords": [
    "music",
    "riyaz",
    "indian-classical-music",
    "pitch-detection",
    "tanpura",
    "harmonium",
    "tabla",
    "web-audio"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@playwright/test": "^1.65.1",
    "jest": "^30.5.2"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/browser/"
    ]
  }
}

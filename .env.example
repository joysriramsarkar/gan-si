PORT=3000
NODE_ENV=development
UPLOAD_DIR=./uploads
# SQLite file (WAL mode). Backup = copy this file.
DB_PATH=./data/gansi.sqlite
# Comma-separated allowed origins. Empty = same-origin only in production.
CORS_ORIGIN=
MAX_UPLOAD_MB=25
MAX_RECORDING_MIN=15
# Asia/Kolkata day boundary is used for streaks.
TZ=Asia/Kolkata
